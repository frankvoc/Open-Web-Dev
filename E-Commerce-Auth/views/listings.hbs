<h1>Browse Listings</h1>
<ul>
  {{#each listings}}
    <li>
      <h2>{{title}}</h2>
      <p>{{description}}</p>
      <p>Current Bid: ${{currentBid}}</p>
      <p>End Time: {{endTime}}</p>
      <a href="/listing/{{_id}}">View Listing</a>
    </li>
  {{/each}}
</ul>
<a href="/dashboard">Back to Dashboard</a>
