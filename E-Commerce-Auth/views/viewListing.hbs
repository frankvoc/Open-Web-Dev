<h1>{{listing.title}}</h1>
<p>{{listing.description}}</p>
<p>Current Bid: ${{listing.currentBid}}</p>
<p>End Time: {{listing.endTime}}</p>
<h3>Bids</h3>
<ul>
  {{#each listing.bids}}
    <li>
      Bid Amount: ${{this.amount}} on {{this.timestamp}}
    </li>
  {{/each}}
</ul>
<form action="/bids/{{listing._id}}" method="POST">
  <label for="amount">Place a Bid:</label>
  <input type="number" id="amount" name="amount" required>
  <button type="submit">Place Bid</button>
  <a href="/listing/{{_id}}">View Listing</a>
</form>
