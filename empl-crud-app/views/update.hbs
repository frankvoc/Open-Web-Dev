<!DOCTYPE html>
<html>
<head>
  <title>Update Employee</title>
  <link rel="stylesheet" type="text/css" href="/style.css">
</head>
<body>
  <h1>Update Employee</h1>
  <form action="/employees/update/{{employee._id}}" method="POST">
    <label for="firstName">First Name:</label>
    <input type="text" id="firstName" name="firstName" value="{{employee.firstName}}" required><br>
    <label for="lastName">Last Name:</label>
    <input type="text" id="lastName" name="lastName" value="{{employee.lastName}}" required><br>
    <label for="department">Department:</label>
    <select id="department" name="department" required>
      <option value="HR" {{#if (eq employee.department 'HR')}}selected{{/if}}>HR</option>
      <option value="Engineering" {{#if (eq employee.department 'Engineering')}}selected{{/if}}>Engineering</option>
      <option value="Marketing" {{#if (eq employee.department 'Marketing')}}selected{{/if}}>Marketing</option>
      <option value="Information Technology" {{#if (eq employee.department 'Information Technology')}}selected{{/if}}>Information Technology</option>
      <option value="Game Design" {{#if (eq employee.department 'Game Design')}}selected{{/if}}>Game Design</option>
      <option value="Business Operations" {{#if (eq employee.department 'Business Operations')}}selected{{/if}}>Business Operations</option>
    </select><br>
    <label for="startDate">Start Date:</label>
    <input type="date" id="startDate" name="startDate" value="{{employee.startDate}}" required><br>
    <label for="jobTitle">Job Title:</label>
    <input type="text" id="jobTitle" name="jobTitle" value="{{employee.jobTitle}}" required><br>
    <label for="salary">Salary:</label>
    <input type="number" id="salary" name="salary" value="{{employee.salary}}" required><br>
    <button type="submit">Update Employee</button>
  </form>
  <a href="/employees">View All Employees</a>
</body>
</html>
